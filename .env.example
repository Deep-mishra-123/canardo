# -----------------------------------------------------------------------------
# CANARDO Floor Care — environment configuration
# -----------------------------------------------------------------------------

# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Delivery fee in INR. Set to 0 for complimentary delivery.
DELIVERY_FEE=0

# -----------------------------------------------------------------------------
# Admin access — demo/local mode
# Used automatically when Supabase is not configured.
# CHANGE THESE BEFORE DEPLOYING.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@canardo.com
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=create-a-long-random-secret-at-least-32-characters

# -----------------------------------------------------------------------------
# Supabase (production)
# When both URL and keys are present, Supabase Auth + Postgres + Storage are used.
# Run supabase/schema.sql in the Supabase SQL editor first.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public storage bucket for product images (created by schema.sql)
SUPABASE_PRODUCT_BUCKET=product-images
